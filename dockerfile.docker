# Use an official Java 17 image
FROM eclipse-temurin:17-jdk

# Set the working directory inside the container
WORKDIR /app

# Copy your Maven wrapper and project files
COPY . .

# Make the Maven wrapper executable and build the JAR (skip tests for speed)
RUN chmod +x mvnw && ./mvnw clean package -DskipTests

# Expose port 8080 (Render uses this)
EXPOSE 8080

# Start the Spring Boot application
CMD ["java", "-jar", "target/cyberedge-0.0.1-SNAPSHOT.jar"]
